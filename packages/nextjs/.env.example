# Template for NextJS environment variables.
#
# For local development: copy to .env.local and fill in values.
# For production: set these in Vercel (or your host) environment.
#
# Client-side: use NEXT_PUBLIC_* prefix. Server-only: no prefix.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# -----------------------------------------------------------------------------
# Chain / wallet (Scaffold-ETH)
# -----------------------------------------------------------------------------
# Alchemy API key for RPC. If set, Base Sepolia uses Alchemy (traffic shows in Alchemy dashboard).
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Override Base Sepolia RPC URL (optional). If set, this URL is used INSTEAD of Alchemy.
# So to see activity in Alchemy: leave this unset and set NEXT_PUBLIC_ALCHEMY_API_KEY above,
# or set this to your Alchemy URL: https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# WalletConnect project ID. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# IPFS / Pinata
# -----------------------------------------------------------------------------
# Gateway URL for reading IPFS content (must end with /ipfs/).
# NEXT_PUBLIC_IPFS_GATEWAY=

# Pinata JWT for uploading to your Pinata account (server-only; required for IPFS uploads).
PINATA_JWT=

# -----------------------------------------------------------------------------
# Arweave / Irys (server-only)
# -----------------------------------------------------------------------------
# Private key for the Irys uploader (Arweave). Required for evidence upload.
IRYS_PRIVATE_KEY=

# RPC URL for Irys (optional; defaults to Base Sepolia).
# IRYS_RPC_URL=

# -----------------------------------------------------------------------------
# Ponder indexer
# -----------------------------------------------------------------------------
# Base URL of the Ponder indexer (no trailing slash).
# Local: http://localhost:42069  |  Production: https://your-indexer.up.railway.app
# If unset, the app uses Supabase or chain event history for the proof list.
NEXT_PUBLIC_INDEXER_URL=

# -----------------------------------------------------------------------------
# Supabase (proof metadata mirror)
# -----------------------------------------------------------------------------
# Supabase project URL (from project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Service role key (server-only; from project Settings > API). Required for API routes /api/proofs.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Build / dev (optional)
# -----------------------------------------------------------------------------
# Set to "true" to ignore TypeScript/ESLint errors during build (e.g. vercel:yolo).
# NEXT_PUBLIC_IGNORE_BUILD_ERROR=

# Set to "true" when building for IPFS deployment (e.g. yarn ipfs).
# NEXT_PUBLIC_IPFS_BUILD=
